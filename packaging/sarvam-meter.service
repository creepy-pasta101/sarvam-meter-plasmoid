#
# systemd *user* unit for the sarvam-meter daemon.
#
# The RPM installs this to /usr/lib/systemd/user/sarvam-meter.service. Enable it
# for the current user only (never system-wide):
#
#     systemctl --user daemon-reload
#     systemctl --user enable --now sarvam-meter.service
#     journalctl --user -u sarvam-meter.service -f
#
# To keep it running while you are logged out:
#
#     loginctl enable-linger "$USER"
#
# `serve` starts the daemon and nothing else. This project relays no API
# traffic and opens no port for one: the daemon's only endpoint is its own local
# socket, which serves the widget.

[Unit]
Description=Sarvam AI usage meter daemon
Documentation=https://github.com/creepy-pasta101/sarvam-meter-plasmoid
# A user unit: it does not order against the system network target.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Environment=SARVAM_METER_CONFIG=%h/.config/sarvam-meter/config.json
Environment=PYTHONUNBUFFERED=1
# Create a default config on first start only; never overwrite an edited one.
ExecStartPre=/usr/bin/sarvam-meter init --if-missing
ExecStart=/usr/bin/sarvam-meter serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
# The daemon binds a loopback socket only and stores its state under $HOME.
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target

{
  "version": 1,
  "db_path": "~/.local/share/sarvam-meter/usage.db",
  "daemon": {
    "host": "127.0.0.1",
    "port": 8787,
    "refresh_seconds": 60,
    "request_timeout_seconds": 10
  },
  "sarvam": {
    "enabled": true,
    "currency": "INR",
    "starting_balance": null,
    "rate_overrides": {}
  },
  "cliproxy": {
    "enabled": false,
    "base_url": "http://127.0.0.1:8317",
    "management_key": "",
    "api_version": "v8",
    "quota_fetch": true,
    "quota_fetch_interval_seconds": 300,
    "include_api_key_usage": false,
    "allow_remote": false
  },
  "dashboard": {
    "enabled": true,
    "base_url": "https://indus.sarvam.ai",
    "session_file": "~/.config/sarvam-meter/session.json",
    "poll_seconds": 300,
    "product": "sarvam-api-platform"
  }
}
